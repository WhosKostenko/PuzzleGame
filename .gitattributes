# ---------------------------------------------------------------------------
# Unity Git Configuration
# ---------------------------------------------------------------------------

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# ---------------------------------------------------------------------------
# Macro Definitions
# ---------------------------------------------------------------------------
# Define Unity YAML merging and linguistic behaviors
[attr]unity-yaml merge=unityyamlmerge eol=lf linguist-language=yaml
[attr]unity-json eol=lf linguist-language=json
[attr]lfs-file   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Source Code & Text Formats
# ---------------------------------------------------------------------------
*.cs diff=csharp text
*.cginc text
*.hlsl text
*.shader text
*.compute text
*.glsl text
*.raytrace text
*.uss text
*.uxml text

# ---------------------------------------------------------------------------
# Unity YAML & Text Assets (Force Text Serialization)
# ---------------------------------------------------------------------------
*.meta unity-yaml
*.unity unity-yaml
*.prefab unity-yaml
*.asset unity-yaml
*.mat unity-yaml
*.anim unity-yaml
*.controller unity-yaml
*.overrideController unity-yaml
*.playable unity-yaml
*.preset unity-yaml
*.mask unity-yaml
*.brush unity-yaml
*.flare unity-yaml
*.fontsettings unity-yaml
*.guiskin unity-yaml
*.giparams unity-yaml
*.lighting unity-yaml
*.mixer unity-yaml
*.renderTexture unity-yaml
*.scenetemplate unity-yaml
*.shadervariants unity-yaml
*.signal unity-yaml
*.spriteatlas unity-yaml
*.spriteatlasv2 unity-yaml
*.terrainlayer unity-yaml
*.physicMaterial unity-yaml
